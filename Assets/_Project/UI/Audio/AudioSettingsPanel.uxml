<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:kit="TpsDungeon.UiKit" editor-extension-mode="False">
    <ui:Template name="AudioVolumeRows" src="project://database/Assets/_Project/UI/Audio/AudioVolumeRows.uxml" />
    <Style src="project://database/Assets/_Project/UI/Theme/Theme.uss" />
    <Style src="project://database/Assets/_Project/UI/Audio/AudioSettingsPanel.uss" />
    <ui:VisualElement name="scrim" class="rpg-scrim">
        <kit:Vignette />
        <ui:VisualElement class="rpg-stage" picking-mode="Ignore">
            <ui:VisualElement name="panel" class="rpg-panel audio-panel">
                <kit:OrnateFrame crest="true" />
                <ui:VisualElement class="rpg-heading">
                    <ui:Label text="— AUDIO —" class="rpg-heading__caption rpg-deco" />
                    <ui:Label text="音" class="rpg-heading__title rpg-bold" />
                    <ui:VisualElement class="rpg-rule">
                        <ui:VisualElement class="rpg-rule__line" />
                        <ui:VisualElement class="rpg-rule__gem" />
                        <ui:VisualElement class="rpg-rule__line" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="page" class="rpg-page">
                    <ui:Instance template="AudioVolumeRows" name="volume-rows" />
                </ui:VisualElement>

                <ui:VisualElement class="rpg-actions">
                    <ui:Button name="reset-button" text="既定に戻す" class="rpg-button" />
                    <ui:Button name="close-button" text="閉じる" class="rpg-button rpg-button--primary" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
