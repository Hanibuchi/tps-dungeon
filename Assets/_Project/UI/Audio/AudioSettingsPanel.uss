/* 城の中の設定画面。石と松明の色味に寄せた暗色ベース。 */
:root {
    --ink: rgb(236, 228, 214);
    --ink-dim: rgb(150, 141, 127);
    --stone: rgb(28, 26, 24);
    --stone-raised: rgb(44, 41, 37);
    --edge: rgb(72, 66, 58);
    --torch: rgb(214, 158, 74);
}

/* 画面いっぱいの覆い。親の大きさに依存しないよう四辺固定で広げる。 */
.scrim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.55);
}

.panel {
    width: 460px;
    max-width: 92%;
    padding: 24px 28px 20px 28px;
    background-color: var(--stone);
    border-width: 1px;
    border-color: var(--edge);
    border-radius: 4px;
}

.panel__title {
    color: var(--torch);
    font-size: 20px;
    letter-spacing: 6px;
    -unity-font-style: bold;
    margin-bottom: 10px;
}

.panel__rule {
    height: 1px;
    background-color: var(--edge);
    margin-bottom: 18px;
}

.row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 14px;
}

.row__label {
    width: 86px;
    color: var(--ink-dim);
    font-size: 13px;
    letter-spacing: 2px;
}

.row__slider {
    flex-grow: 1;
    margin-left: 4px;
    margin-right: 12px;
}

/* スライダーの溝とつまみ。既定のままだと明るすぎて背景から浮く。 */
.row__slider .unity-base-slider__tracker {
    height: 3px;
    background-color: var(--stone-raised);
    border-width: 0;
}

.row__slider .unity-base-slider__dragger {
    width: 14px;
    height: 14px;
    margin-top: -7px;
    border-radius: 7px;
    background-color: var(--torch);
    border-width: 0;
}

.row__value {
    width: 52px;
    color: var(--ink);
    font-size: 13px;
    -unity-text-align: middle-right;
}

.actions {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 10px;
}

.button {
    height: 32px;
    padding-left: 18px;
    padding-right: 18px;
    margin-left: 8px;
    font-size: 12px;
    letter-spacing: 2px;
    color: var(--stone);
    background-color: var(--torch);
    border-width: 0;
    border-radius: 3px;
}

.button:hover {
    background-color: rgb(232, 178, 96);
}

.button--ghost {
    color: var(--ink-dim);
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: var(--edge);
}

.button--ghost:hover {
    color: var(--ink);
    background-color: var(--stone-raised);
}
