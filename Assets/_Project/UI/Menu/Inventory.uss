/* インベントリ画面。色・書体・枠・パネル・枠（.slot）・情報欄（.item-details）は Theme.uss。 */

.inventory {
    padding-bottom: 22px;
}

.inventory__body {
    flex-direction: row;
    align-items: stretch;
}

.inventory__slots {
    align-items: flex-start;
}

.inventory__caption {
    margin: 0 0 8px 4px;
    padding: 0;
    font-size: 13px;
    letter-spacing: 4px;
    color: var(--brass);
}

/* 6 列で折り返す。枠 64px + 左右の余白 4px ずつ。 */
.inventory__bag {
    width: 432px;
    flex-direction: row;
    flex-wrap: wrap;
}

.inventory__hotbar {
    flex-direction: row;
    margin-top: 8px;
}

.inventory__divider {
    align-self: stretch;
    height: 1px;
    margin: 10px 4px 14px 4px;
    background-color: var(--brass-dim);
}

.inventory .slot {
    margin: 4px;
}

/* 枠は触れる。合わせると金の縁が灯る。 */
.inventory .slot:hover {
    border-color: var(--gold);
    background-color: var(--gold-glow);
}

/* ドラッグ中、掴んだ枠は抜け殻として薄くする。 */
.inventory .slot.slot--drag-source .slot__icon {
    opacity: 0.25;
}

/* ドラッグ中、離すと入る枠。 */
.inventory .slot.slot--drop-target {
    border-color: var(--gold-bright);
    background-color: var(--gold-glow-strong);
    scale: 1.06 1.06;
}

/* 移動先が埋まっていて動かせなかったとき、一瞬赤く灯る。 */
.inventory .slot.slot--denied {
    border-color: var(--blood-bright);
    translate: 3px 0;
    transition-duration: 0.05s;
}

/* ---- 仲間の並び（左の欄）。2 列 6 段で、左の列の上から 1, 2, … と数える。 ---- */

.inventory__party {
    margin-right: 22px;
}

.party-list {
    width: 300px;
    height: 264px;
    flex-direction: column;
    flex-wrap: wrap;
    align-content: flex-start;
}

.party-card {
    width: 144px;
    height: 38px;
    margin: 3px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(20, 17, 15, 0.84);
    border-width: 1px;
    border-color: var(--brass-dim);
    transition-property: translate, scale, border-color, background-color, opacity;
    transition-duration: 0.2s;
    transition-timing-function: ease-out-cubic;
}

.party-card:hover {
    border-color: var(--gold);
    background-color: var(--gold-glow);
}

/* 手元を出している人。 */
.party-card.party-card--selected {
    border-color: var(--gold-bright);
    background-color: rgba(52, 42, 30, 0.92);
}

/* 角・耳・しっぽの色。 */
.party-card__swatch {
    width: 6px;
    align-self: stretch;
    margin-right: 6px;
}

.party-card__number {
    width: 18px;
    margin: 0;
    padding: 0;
    font-size: 12px;
    color: var(--ink-faint);
    -unity-text-align: middle-center;
}

.party-card__text {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

.party-card__name {
    margin: 0;
    padding: 0;
    font-size: 13px;
    color: var(--ink);
    white-space: nowrap;
    text-overflow: ellipsis;
}

.party-card__level {
    margin: 0;
    padding: 0;
    font-size: 10px;
    color: var(--ink-dim);
}

.party-card__badge {
    display: none;
    margin: 0 5px 0 0;
    padding: 1px 4px;
    font-size: 9px;
    color: var(--stone);
    background-color: var(--gold);
}

.party-card.party-card--leader .party-card__badge {
    display: flex;
}

.party-card.party-card--leader .party-card__number {
    color: var(--gold-bright);
}

/* ドラッグ中、掴んだ札は抜け殻として薄くする。 */
.party-card.party-card--drag-source {
    opacity: 0.35;
}

/* ドラッグ中、離すとその位置に入る札（武器なら、その人の手元に入る）。 */
.party-card.party-card--drop-target {
    border-color: var(--gold-bright);
    background-color: var(--gold-glow-strong);
    scale: 1.04 1.04;
}

/* 手元が埋まっていて渡せなかったとき、一瞬赤く灯る。 */
.party-card.party-card--denied {
    border-color: var(--blood-bright);
    translate: 3px 0;
    transition-duration: 0.05s;
}

.inventory__details {
    margin-left: 24px;
    width: 250px;
}

.inventory__details.inventory__details--empty .item-details__well {
    opacity: 0.35;
}

.inventory__details.inventory__details--empty .item-details__title {
    color: var(--ink-faint);
}

/* ポインタに付いてくる、掴んでいるアイテムの絵。 */
.inventory-ghost {
    position: absolute;
    width: 56px;
    height: 56px;
    display: none;
    opacity: 0.9;
    scale: 1.1 1.1;
    -unity-background-scale-mode: scale-to-fit;
}
