/* 照準とインタラクトのプロンプト。設定画面（AudioSettingsPanel.uss）と同じ石と松明の色味。 */
:root {
    --ink: rgb(236, 228, 214);
    --stone: rgba(28, 26, 24, 0.82);
    --edge: rgb(72, 66, 58);
    --torch: rgb(214, 158, 74);
}

/* 画面いっぱいに広げて、子を中央に寄せる。 */
.hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

/* 画面中央の点。レイはここを通る。 */
.reticle {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background-color: var(--ink);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.6);
    opacity: 0.85;
}

/* 照準のすぐ下に出す。中央からずらすため絶対配置にして、照準の位置を動かさない。 */
.prompt {
    position: absolute;
    top: 54%;
    flex-direction: row;
    align-items: center;
    padding: 6px 12px 6px 6px;
    background-color: var(--stone);
    border-width: 1px;
    border-color: var(--edge);
    border-radius: 4px;
}

.prompt__key {
    min-width: 28px;
    height: 28px;
    padding: 0 6px;
    margin: 0 10px 0 0;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 15px;
    color: var(--stone);
    background-color: var(--torch);
    border-radius: 3px;
}

.prompt__action {
    padding: 0;
    margin: 0;
    font-size: 16px;
    letter-spacing: 1px;
    color: var(--ink);
}
