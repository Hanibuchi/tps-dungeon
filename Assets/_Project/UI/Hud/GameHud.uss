/* 常時表示の HUD。左下 レベル・HP・経験値、下中央ホットバー、右下マップ。色・書体・飾り枠は Theme.uss。 */

/* 画面いっぱいに広げ、子は四隅・下辺に絶対配置する。 */
.game-hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* HUD の小さな枠は、内側の線を詰めて角の菱形も小さくする。 */
.hud-frame {
    --frame-inset: 4;
    --frame-gap: 2;
    --frame-corner-gap: 6;
}

.hud-frame .ornate-frame__corner {
    width: 8px;
    height: 8px;
    border-width: 1px;
}

.hud-frame .ornate-frame__corner--tl { left: 0; top: 0; }
.hud-frame .ornate-frame__corner--tr { right: 0; top: 0; }
.hud-frame .ornate-frame__corner--bl { left: 0; bottom: 0; }
.hud-frame .ornate-frame__corner--br { right: 0; bottom: 0; }

/* ---- 左下: HP ---- */

.hp {
    position: absolute;
    left: 28px;
    bottom: 28px;
    width: 300px;
    padding: 12px 18px 14px 18px;
    background-color: rgba(20, 17, 15, 0.84);
    transition-property: translate;
    transition-duration: 0.08s;
}

/* 被弾した瞬間に小さく揺れる。 */
.hp.hp--hit {
    translate: 4px 0;
}

.hp__header {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 7px;
}

.hp__caption {
    padding: 0;
    margin: 0;
    font-size: 15px;
    letter-spacing: 3px;
    color: var(--gold);
}

.hp__value {
    padding: 0;
    margin: 0;
    font-size: 15px;
    color: var(--ink);
    transition-property: color;
    transition-duration: 0.3s;
}

.hp__track {
    height: 12px;
    background-color: rgba(0, 0, 0, 0.6);
    border-width: 1px;
    border-color: var(--brass-dim);
    overflow: hidden;
}

/* 削れ跡。本体より遅れて、ゆっくり追いつく。 */
.hp__trail {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    background-color: rgb(236, 196, 140);
    transition-property: width;
    transition-duration: 0.55s;
    transition-delay: 0.35s;
    transition-timing-function: ease-in-out-cubic;
}

.hp__fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    background-color: var(--blood);
    border-right-width: 1px;
    border-color: rgba(255, 180, 150, 0.6);
    transition-property: width, background-color;
    transition-duration: 0.18s, 0.3s;
    transition-timing-function: ease-out-cubic;
}

.hp--low .hp__fill {
    background-color: var(--blood-bright);
}

.hp--low .hp__value {
    color: var(--blood-bright);
}

/* 残りが少ないときの鼓動。GameHudView が .hp--beat を付け外しする。 */
.hp--low.hp--beat .hp__fill {
    background-color: rgb(250, 110, 80);
}

.hp--low .ornate-frame__corner {
    background-color: var(--blood-bright);
}

.hp--low.hp--beat .ornate-frame__corner {
    background-color: var(--ember);
    scale: 1.3 1.3;
}

/* ---- 左下: レベルと経験値（HP と同じ枠の中） ---- */

.level {
    flex-direction: row;
    align-items: flex-end;
    margin-bottom: 6px;
    transition-property: scale;
    transition-duration: 0.12s;
    transition-timing-function: ease-out-back;
    transform-origin: left bottom;
}

.level__caption {
    padding: 0;
    margin: 0 5px 2px 0;
    font-size: 13px;
    letter-spacing: 2px;
    color: var(--gold);
}

.level__value {
    padding: 0;
    margin: 0;
    font-size: 22px;
    color: var(--gold-bright);
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.9);
    transition-property: color;
    transition-duration: 0.4s;
}

/* レベルが上がった瞬間だけ大きく明るくする。GameHudView が一瞬だけ付ける。 */
.level.level--up {
    scale: 1.25 1.25;
}

.level--up .level__value {
    color: rgb(255, 246, 214);
}

/* 経験値は数字を出さず、HP の下の細い帯の伸びだけで見せる。 */
.exp {
    height: 5px;
    margin-top: 6px;
    background-color: rgba(0, 0, 0, 0.6);
    border-width: 1px;
    border-color: var(--brass-dim);
    overflow: hidden;
}

.exp__fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0;
    background-color: var(--gold);
    transition-property: width, background-color;
    transition-duration: 0.35s, 0.3s;
    transition-timing-function: ease-out-cubic;
}

/* レベルアップで空に戻すときは、減っていく様子を見せずに一瞬で戻す。 */
.exp__fill.exp__fill--instant {
    transition-duration: 0s, 0s;
}

/* 四分の一ごとの目盛り。数字の代わりの目安。 */
.exp__tick {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background-color: rgba(20, 17, 15, 0.7);
}

.exp__tick--25 { left: 25%; }
.exp__tick--50 { left: 50%; }
.exp__tick--75 { left: 75%; }

/* 最大レベルでは満タンのまま明るく光らせる。 */
.exp--max .exp__fill {
    background-color: var(--gold-bright);
}

.exp--max {
    border-color: var(--gold);
}

/* ---- 下中央: ホットバー ---- */

/* 左右 0 で横いっぱいに広げ、中身を中央に寄せる。 */
.hotbar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 28px;
    flex-direction: row;
    justify-content: center;
    align-items: flex-end;
}

/* 枠の見た目（.slot*）はインベントリ画面と共有するので Theme.uss にある。 */

/* 選んでいる枠のアイテム名。選んだ枠（持ち上がって宝石が載る）の少し上に出す。 */
.hotbar-name {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 120px;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
    font-size: 17px;
    letter-spacing: 2px;
    color: var(--ink);
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.9);
    opacity: 0;
    translate: 0 6px;
    transition-property: opacity, translate;
    transition-duration: 0.25s;
    transition-timing-function: ease-out-cubic;
}

.hotbar-name.is-shown {
    opacity: 1;
    translate: 0 0;
}

/* 名前が変わった瞬間だけ沈んで浮き直す。GameHudView が一瞬だけ付ける。 */
.hotbar-name.is-shown.hotbar-name--pop {
    opacity: 0.35;
    translate: 0 5px;
}

/* ---- 右下: マップ ---- */

.minimap {
    position: absolute;
    right: 28px;
    bottom: 28px;
    width: 200px;
    height: 200px;
    background-color: rgba(20, 17, 15, 0.84);
    opacity: 0;
    scale: 0.94 0.94;
    transition-property: opacity, scale;
    transition-duration: 0.25s;
    transition-timing-function: ease-out-cubic;
}

.minimap.is-shown {
    opacity: 1;
    scale: 1 1;
}

/* 描画ははみ出すので、枠の内側で切り取る。 */
.minimap__clip {
    position: absolute;
    left: 5px;
    top: 5px;
    right: 5px;
    bottom: 5px;
    overflow: hidden;
}

.minimap__canvas {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;

    /* MinimapElement が customStyle で読む描画色。要素自身のルールに書かないと拾えない。 */
    --map-room: rgb(66, 58, 48);
    --map-room-current: rgb(108, 92, 70);
    --map-room-edge: rgb(150, 122, 82);
    --map-door: rgb(214, 170, 92);
    --map-feature: rgb(236, 226, 206);
    --map-player: rgb(248, 220, 150);
    --map-pixels-per-cell: 32;
}

/* ---- マップキーで開く大きな地図 ---- */

/* 画面いっぱいに薄く暗くして、真ん中に大きな枠を置く。開閉は GameHudView が UiTransitions で行う。 */
.map-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(6, 4, 3, 0);
    transition-property: background-color;
    transition-duration: 0.3s;
    transition-timing-function: ease-out-cubic;
}

.map-overlay.is-shown {
    background-color: rgba(6, 4, 3, 0.5);
}

/* 正方形。PanelSettings が画面の大きさに合わせて拡縮するので、720p 基準の固定サイズでよい。
 * UI を 1.5 倍にしても地図だけは画面に収まる大きさのままにしたいので、他と違って拡大しない。 */
.map-large {
    width: 504px;
    height: 504px;
    /* 大きいぶん背後の景色が透けると部屋が読みにくいので、小さい地図より濃くする。 */
    background-color: rgba(20, 17, 15, 0.96);
    opacity: 0;
    scale: 0.9 0.9;
    rotate: -1.5deg;
    transition-property: opacity, scale, rotate;
    transition-duration: 0.25s, 0.4s, 0.4s;
    transition-timing-function: ease-out-cubic, ease-out-back, ease-out-back;
}

.map-overlay.is-shown .map-large {
    opacity: 1;
    scale: 1 1;
    rotate: 0deg;
}

.map-large__clip {
    position: absolute;
    left: 8px;
    top: 8px;
    right: 8px;
    bottom: 8px;
    overflow: hidden;
}

/* 小さい地図と同じ要素を、寄って大きく描く。枠を縮めたぶん縮尺も合わせ、見える範囲を変えない。 */
.map-large__canvas {
    --map-pixels-per-cell: 42;
}

.map-large__caption {
    position: absolute;
    top: -34px;
    left: 0;
    right: 0;
    font-size: 14px;
    letter-spacing: 8px;
    color: var(--gold);
    -unity-text-align: middle-center;
}

/* ---- ダメージの数字（DamageNumberView） ---- */

/* 画面いっぱいの層。HUD の枠より奥に敷く。 */
.damage-numbers {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* left / top に当たった場所の画面座標が入る。数字（と COMBO）の下辺の中央をそこへ合わせる。
   色・大きさ・縁取りは中の数字と COMBO へ受け継がせる。 */
.damage-number {
    position: absolute;
    translate: -50% -100%;
    flex-direction: column;
    align-items: center;
    padding: 0;
    margin: 0;
    font-size: 32px;
    color: var(--ink);
    -unity-text-outline-width: 1.5px;
    -unity-text-outline-color: rgb(0, 0, 0);
    text-shadow: 0 2px 3px rgba(0, 0, 0, 0.9);
    white-space: nowrap;
}

.damage-number.damage-number--critical {
    font-size: 44px;
    color: var(--gold-bright);
}

/* エンチャント（爆発・追撃）の一撃。 */
.damage-number.damage-number--minor {
    font-size: 26px;
    color: var(--ember);
}

.damage-number__value,
.damage-number__critical,
.damage-number__combo {
    padding: 0;
    margin: 0;
    white-space: nowrap;
}

/* クリティカルの 1 撃の数字の下に添える「Critical」。 */
.damage-number__critical {
    margin-top: -8px;
    font-size: 20px;
    color: var(--gold-bright);
    letter-spacing: 1px;
}

/* コンボボーナスが乗った 1 撃の「N COMBO」。数が増えるほど白→金→赤。 */
.damage-number__combo {
    margin-top: -6px;
    font-size: 18px;
    color: var(--ink);
    letter-spacing: 1px;
}

.damage-number__combo.damage-number__combo--hot {
    font-size: 20px;
    color: var(--gold-bright);
}

.damage-number__combo.damage-number__combo--blazing {
    font-size: 22px;
    color: var(--blood-bright);
}
